# Los valores de host, puerto, base y usuario son opcionales si coinciden con los valores de server.xml.
GALENOSV_DB_HOST=localhost
GALENOSV_DB_PORT=5432
GALENOSV_DB_NAME=galenoSV
GALENOSV_DB_USER=admin
GALENOSV_DB_PASSWORD=cambiar-esto

# Credenciales de los usuarios de la aplicación (independientes de PostgreSQL).
GALENO_ADMIN_PASSWORD=cambiar-admin
GALENO_CLINICO_PASSWORD=cambiar-clinico

# Ejecutar scripts/configurar-seguridad-local.ps1 para generar estas dos claves.
GALENOSV_KEYSTORE_PASSWORD=
GALENOSV_LTPA_PASSWORD=
