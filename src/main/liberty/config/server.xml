<?xml version="1.0" encoding="UTF-8"?>
<server description="GalenoSV Server">

    <featureManager>
        <feature>jakartaee-11.0</feature>
        <feature>localConnector-1.0</feature>
    </featureManager>

    <basicRegistry id="basic" />


    <httpEndpoint id="defaultHttpEndpoint"
                  httpPort="9080"
                  httpsPort="9443"/>

    <dataSource id="galenoSV" jndiName="jdbc/galenoSV">
        <jdbcDriver libraryRef="PostgreSQLLib"/>
        <properties.postgresql
            serverName="localhost"
            portNumber="5432"
            databaseName="galenoSV"
            user="admin"
            password="admin"/>
    </dataSource>

    <library id="PostgreSQLLib">
        <fileset dir="${server.config.dir}/lib" includes="postgresql-*.jar"/>
    </library>

    <webApplication location="GalenoSV-1.0-SNAPSHOT.war" contextRoot="/galenoSV">
    <classloader apiTypeVisibility="spec,ibm-api,api,third-party"/>
</webApplication>

</server>
